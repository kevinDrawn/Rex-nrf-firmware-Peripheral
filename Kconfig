# Set this before SDK defaults so bilateral builds actually get 44 bytes.
config ESB_MAX_PAYLOAD_LENGTH
    default 44 if EMG_BILATERAL

source "Kconfig.zephyr"

menu "Enhanced ShockBurst: Transmitter"

config ESB_PTX_APP_LOG_LEVEL
	int "Log level for the ESB PTX sample"
	default 4

endmenu

menu "Custom SAADC Modes"

config HALL_MODE
    bool "Enable Hall sensor mode"
    default n
    help
      Enable this to use Hall_L and Hall_R channels for SAADC.

config CAN_MODE
    bool "Enable CAN sensor mode"
    default n
    help
      Enable this to use Can_L and Can_R channels for SAADC.

config EMG_MODE
    bool "Enable EMG sensor mode"
    default n
    help
      Enable this to use Sequence, Tibial Muscle, Gastrocnemius Muscle channels for SPI DRDY.

endmenu


choice EMG_CHANNEL_MODE
    prompt "EMG channel configuration"
    depends on EMG_MODE
    default EMG_UNILATERAL

config EMG_UNILATERAL
    bool "Unilateral EMG (ADS1294 Ch1 and Ch2)"

config EMG_BILATERAL
    bool "Bilateral EMG (ADS1294 Ch1 through Ch4)"

endchoice

